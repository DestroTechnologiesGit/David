# Use a new random value. This is the restricted key users enter in Studio;
# never put the OpenClaw gateway owner token here.
STUDIO_ACCESS_TOKEN=replace-with-a-long-random-value

STUDIO_NODE_HOST=127.0.0.1
STUDIO_NODE_PORT=18881
OPENCLAW_GATEWAY=http://127.0.0.1:18789
OPENCLAW_CONFIG=/home/ubuntu/.openclaw/openclaw.json
OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
STUDIO_CHAT_MODEL=qwen3:1.7b
STUDIO_CHAT_DEFAULT_TOKENS=768
STUDIO_CHAT_MAX_TOKENS=3072
STUDIO_CHAT_CONTEXT_TOKENS=8192
SHARED_NOTES_DIR=/home/ubuntu/livecontent-shared-notes
STUDIO_MAX_SHARED_AUDIO_BYTES=67108864
BIOFORMER_RANK_URL=http://127.0.0.1:18880/health-rank
DOCUMENT_CONVERT_URL=http://127.0.0.1:18880/convert
KOKORO_URL=http://127.0.0.1:8890/api
STUDIO_ALLOWED_MODELS=openclaw/studio,openclaw/translator
