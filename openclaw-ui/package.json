{
  "name": "livecontent-studio-ui",
  "private": true,
  "description": "LiveContent Studio UI and its private Node.js backend-for-frontend. PDF.js is vendored for browser document import.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test server.test.js",
    "check": "node --check server.js && node --check app.js",
    "vendor": "npm install && cp node_modules/pdfjs-dist/legacy/build/pdf.min.mjs node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs vendor/"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
