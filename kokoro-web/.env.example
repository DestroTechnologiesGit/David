# Kokoro web bridge configuration.
# Copy to kokoro-web/.env and adjust for the host.

# Bind address and port. Use 0.0.0.0 to accept connections from other
# machines; 127.0.0.1 keeps the API reachable only from this host.
KOKORO_HOST=127.0.0.1
KOKORO_PORT=8890

# API token callers must send as `Authorization: Bearer <token>`.
# Set this to run anywhere; without it the server falls back to reading
# OPENCLAW_CONFIG, which only exists on the original deployment.
KOKORO_API_TOKEN=

# Origins allowed to call the API from a browser. "*" allows any origin,
# a comma-separated list restricts it, and empty disables CORS entirely.
KOKORO_CORS_ORIGINS=*

# Defaults applied when a request omits them.
KOKORO_DEFAULT_VOICE=af_sarah
KOKORO_DEFAULT_LANGUAGE=en-us

# Maximum characters accepted per synthesis request (Generate tab).
KOKORO_MAX_TEXT_LENGTH=5000

# Maximum characters for streaming requests. Streaming plays while it
# generates, so a longer document is practical there.
KOKORO_MAX_STREAM_TEXT_LENGTH=10000

# Browser UI served on GET /.
KOKORO_FRONTEND=/home/ubuntu/kokoro-frontend.html

# Fallback token source, used only when KOKORO_API_TOKEN is unset.
OPENCLAW_CONFIG=/home/ubuntu/.openclaw/openclaw.json

# Kokoro TTS CLI executable.
KOKORO_BIN=/home/ubuntu/.local/bin/kokoro-tts

# Optional downloadable multilingual voice used by LiveContent Studio.
# Install requirements-edge.txt in this isolated environment first.
EDGE_TTS_PYTHON=/home/ubuntu/.livecontent-edge-tts-venv/bin/python
EDGE_TTS_HELPER=/home/ubuntu/David/kokoro-web/edge_tts_helper.py

# Seconds to wait for the next chunk during streaming before giving up.
KOKORO_STREAM_CHUNK_TIMEOUT=180
