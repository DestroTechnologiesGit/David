# Caddy config for OpenClaw + Kokoro. See openclaw-ui/README.md.
51-81-81-208.sslip.io {
    handle /kokoro {
        redir * /kokoro/ 308
    }

    handle_path /kokoro/* {
        reverse_proxy 127.0.0.1:8890
    }

    # Simplified NotebookLM-style UI.
    handle /studio {
        redir * /studio/ 308
    }

    handle_path /studio/* {
        root * /home/ubuntu/openclaw-ui
        header Cache-Control "no-cache, must-revalidate"
        try_files {path} /index.html
        file_server
    }

    # Docling conversion for formats the browser cannot parse itself.
    handle /convert {
        reverse_proxy 127.0.0.1:18880
    }

    # Gateway API for the UI. Same origin, so no CORS setup is needed.
    handle_path /openclaw-api/* {
        reverse_proxy 127.0.0.1:18789
    }

    # Built-in OpenClaw Control UI stays at the root, untouched.
    reverse_proxy 127.0.0.1:18789
}
